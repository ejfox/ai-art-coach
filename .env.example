# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Optional: Specify your app name and URL for OpenRouter analytics
OPENROUTER_APP_NAME=ai-art-coach
OPENROUTER_APP_URL=https://github.com/ejfox/ai-art-coach

# Model Configuration
# Default model to use (can be overridden in code)
# Popular options:
# - anthropic/claude-3.5-sonnet (recommended for coaching)
# - openai/gpt-4-turbo
# - openai/gpt-4
# - openai/gpt-3.5-turbo
# - meta-llama/llama-3.1-70b-instruct
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Temperature setting (0.0 - 2.0, higher = more creative)
DEFAULT_TEMPERATURE=0.7

# Max tokens for responses
MAX_TOKENS=500
